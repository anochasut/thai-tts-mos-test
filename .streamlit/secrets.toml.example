# Copy to .streamlit/secrets.toml for local runs, or paste the same TOML into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# .streamlit/secrets.toml is gitignored -- never commit the real one.

# --- results storage (private Hugging Face dataset repo) ---
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESULTS_REPO_ID = "your-username/thai-tts-mos-results"

# --- who may see the conductor's "Monitor participants" dashboard ---
ADMIN_EMAILS = "you@example.com, colleague@example.com"

# --- optional: restrict who may take the test (leave out = any Google account) ---
# ALLOWED_EMAILS = "listener1@gmail.com, listener2@gmail.com"

# --- Google sign-in (Streamlit native OIDC) ---
[auth]
# Must exactly match an "Authorized redirect URI" in your Google OAuth client.
# Local:    http://localhost:8501/oauth2callback
# Deployed: https://<your-app>.streamlit.app/oauth2callback
redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# Any long random string; used to sign the identity cookie. Keep it stable --
# changing it signs everyone out. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }
